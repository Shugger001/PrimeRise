# Copy to .env.local for Next.js + API local dev (`npm run dev`).
# Production: set in Vercel → Project → Environment Variables.

# --- Public (browser + server) — required for /admin login & RSC
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Server-only — waitlist API (POST /api/subscribe) + optional scripts
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# --- Waitlist email notifications (optional but recommended)
# New signups can be forwarded to info@primerisedrinks.com with signup source details.
WAITLIST_NOTIFY_TO=info@primerisedrinks.com
# Use the same address as SMTP_USER unless your provider allows a verified alias.
WAITLIST_NOTIFY_FROM=info@primerisedrinks.com
# Optional: Reply-To on confirmation emails to subscribers (defaults to WAITLIST_NOTIFY_TO)
# WAITLIST_SUBSCRIBER_REPLY_TO=info@primerisedrinks.com
# Optional: dedicated account-signup welcome email sender settings
# ACCOUNT_WELCOME_FROM=info@primerisedrinks.com
# ACCOUNT_WELCOME_REPLY_TO=no-reply@primerisedrinks.com
SMTP_HOST=smtp.your-mail-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# --- One-time backfill (Vercel-only): resend missed waitlist confirmations
# Set this in Vercel env vars and call the endpoint with:
# Authorization: Bearer <WAITLIST_BACKFILL_SECRET>
WAITLIST_BACKFILL_SECRET=change-me

# --- Stripe (checkout) — get keys from https://dashboard.stripe.com/apikeys
# Webhook: Dashboard → Developers → Webhooks → Add endpoint → URL: https://YOUR_DOMAIN/api/webhooks/stripe
#          Events: checkout.session.completed — copy signing secret to STRIPE_WEBHOOK_SECRET
# Optional: set to "false" to force Payment Links on /cart (one bottle per link), even if STRIPE_SECRET_KEY is set.
# If STRIPE_SECRET_KEY is configured and this is omitted, the cart uses Checkout Sessions (correct quantities).
# NEXT_PUBLIC_STRIPE_ENABLED=false
# Optional: Stripe Payment Link for all blends except Pear Vital (hero, cart, other product cards, homepage collection).
# NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/6oU9AT5Ti0Anb7H1dR93y09
# Optional: Payment Link for Pear Vital only (/products card + collection).
# NEXT_PUBLIC_STRIPE_PAYMENT_LINK_PEAR_VITAL=https://buy.stripe.com/14AdR96Xmgzl4Jj1dR93y05
# Optional: Payment Link for the complete 6-product bundle (hero + cart).
# NEXT_PUBLIC_STRIPE_PAYMENT_LINK_BUNDLE=https://buy.stripe.com/aFaaEXa9y3Mzgs1e0D93y0f
# Optional: Payment Link for the 4-product bundle (bundle promo CTA).
# Supports either key name.
# NEXT_PUBLIC_STRIPE_PAYMENT_LINK_BUNDLE_4=https://buy.stripe.com/...
# NEXT_PUBLIC_STRIPE_PAYMENT_LINK_BUNDLE_FOUR=https://buy.stripe.com/...
# Optional: Payment Link for the 12-bottle bundle (bundle promo CTA).
# NEXT_PUBLIC_STRIPE_PAYMENT_LINK_BUNDLE_12=https://buy.stripe.com/00w6oHbdC5UH6RrcWz93y0g
# NEXT_PUBLIC_STRIPE_PAYMENT_LINK_BUNDLE_TWELVE=https://buy.stripe.com/...
# Optional: Savings lines in bundle promo strip (homepage hydrate via /api/products + /products).
# NEXT_PUBLIC_BUNDLE_SAVINGS_DISPLAY=save $45.95
# NEXT_PUBLIC_BUNDLE_SECONDARY_SAVINGS_DISPLAY=save $4.95
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Canonical site URL for Stripe redirects (production)
NEXT_PUBLIC_SITE_URL=https://primerisedrinks.com
# Stripe Checkout shipping countries (ISO 2-letter, comma-separated). Default: US
# CHECKOUT_SHIPPING_COUNTRIES=US,CA

# WhatsApp floating button (digits only, country code included, e.g. US +1 281-555-1234 → 12815551234)
# Match public/whatsapp-config.js for static HTML pages.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Analytics (GA4 — set in Vercel for homepage + /products + cart)
# NEXT_PUBLIC_PRIME_RISE_GA_ID=G-XXXXXXXXXX

# --- Optional
# PRIME_RISE_GA_ID=
# ORDER_CONFIRM_FROM=info@primerisedrinks.com
